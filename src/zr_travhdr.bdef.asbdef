managed implementation in class zbp_r_travhdr unique;
strict ( 2 );
with draft;
define behavior for zr_travhdr alias travel
persistent table ztrvhdr
lock master total etag LastChangedAt
authorization master ( instance )
draft table zdtravhdr
//etag master <field_name>
{
  create ( authorization : global );
  update;
  delete;
  field ( readonly:update ) TravelId;
  association _Item { create; with draft; }

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare;
  mapping for ztrvhdr{
  TravelId = travel_id;
  Status   = status;
  Description = description;
  LastChangedAt = last_changed_at;


  }
}

define behavior for zi_booking_vw alias booking
persistent table zbooking_item
lock dependent by _header
authorization dependent by _header
draft table zdbooking
//etag master <field_name>
{
  update;
  delete;
  field ( readonly ) TravelId;
  association _header;
  mapping for zbooking_item{

    TravelId = travel_id;
  BookingId = booking_id;
  BeginDate = begin_date;
  EndDate = end_date;




  }
}